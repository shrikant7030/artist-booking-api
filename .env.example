# Copy to .env and fill in local values. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MySQL — users, bookings, payments
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=artist_booking

# MongoDB — artist profiles, reviews
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=artist_booking
